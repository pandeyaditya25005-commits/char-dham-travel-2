# ─── Server ───────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ─── MongoDB Atlas ────────────────────────────────────────
# Replace with your MongoDB Atlas connection string.
# Create a free cluster at https://cloud.mongodb.com
# Database will be auto-created on first connection.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/chardham?retryWrites=true&w=majority

# ─── JWT ──────────────────────────────────────────────────
# Generate a strong random secret: openssl rand -hex 64
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# ─── Cloudinary ───────────────────────────────────────────
# Get credentials from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── SMTP (Email) ─────────────────────────────────────────
# For Gmail: Enable 2FA then create an App Password at https://myaccount.google.com/apppasswords
# For SendGrid: Use apikey as SMTP_USER, actual API key as SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_or_api_key

# ─── CORS ─────────────────────────────────────────────────
# Your Vercel frontend URL (no trailing slash)
FRONTEND_URL=https://your-app.vercel.app
